# Variables de entorno (copiar a .env y completar)
PORT=5000
DATABASE_URL=postgres://usuario:password@localhost:5432/ticketera
JWT_SECRET=cambiar-por-un-secreto-largo

# URL donde se abre la web (para el link "ver mis entradas" y la vuelta del pago).
# El backend sirve el frontend: en local es http://localhost:5000
FRONTEND_URL=http://localhost:5000
# Solo si el frontend se sirve desde otro origen (lista separada por comas).
# Fuera de producción CORS ya está abierto
CORS_ORIGIN=

# Minutos que tiene el comprador para pagar en la pasarela (por defecto 15)
PAYMENT_WINDOW_MINUTES=15
# Minutos que se reserva el cupo de una compra sin pagar antes de liberarlo
# (por defecto: la ventana de pago + 5)
# PURCHASE_HOLD_MINUTES=20

# Topes contra el acaparamiento de entradas
MAX_TICKETS_PER_PURCHASE=10
MAX_PENDING_PER_EMAIL=5
# Límites por IP en 10 minutos (checkout) y 15 minutos (login/registro). 0 = sin límite.
# Si compradores reales reciben "demasiados intentos", subilos o ponelos en 0
RATE_LIMIT_CHECKOUT_MAX=60
RATE_LIMIT_AUTH_MAX=30
# Cantidad de proxies delante del servidor (Render: 1, es el valor por defecto en producción)
# TRUST_PROXY=1

# Después de desplegar un cambio en los modelos, poner false: los reinicios dejan de
# modificar las tablas existentes (en Postgres repetirlo puede duplicar índices)
# DB_SYNC_ALTER=false

# Pasarela de pago: "mock" (simulada, solo desarrollo), "mercadopago" o "nave"
PAYMENT_PROVIDER=mock

# Mercado Pago: Access Token de tu aplicación (tuspagos > Credenciales).
# Con las credenciales de prueba (usuarios de prueba) se pagan compras de mentira.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública del backend: ahí avisa Mercado Pago los pagos (/api/purchases/webhook).
# En local hace falta un túnel (ngrok, cloudflared); sin esto el aviso nunca llega.
BACKEND_URL=
# Nave: credenciales que entrega Nave (integraciones@navenegocios.com).
# Sandbox y producción tienen credenciales distintas.
# La notification_url que se le informa a Nave es: https://TU-BACKEND/api/purchases/webhook
# NAVE_POS_ID: Nave > Integraciones > Sistema de gestión (archivo con los IDs de puntos de venta)
NAVE_ENV=sandbox
NAVE_CLIENT_ID=
NAVE_CLIENT_SECRET=
NAVE_AUDIENCE=
NAVE_POS_ID=

# Email con Resend: mientras RESEND_API_KEY esté vacía, no se envían emails
# (el link a las entradas se muestra en la consola del backend)
RESEND_API_KEY=
RESEND_FROM=Ticketera <entradas@tudominio.com>
